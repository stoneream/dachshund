if command -v mise >/dev/null 2>&1; then
  eval "$(mise env -s bash)"
fi

export HOST_UID="$(id -u)"
export HOST_GID="$(id -g)"

export APP_ALLOWED_HOST=localhost
export CORS_ALLOWED_ORIGIN=http://localhost:3000

export DB_ENABLED=false
export DACHSHUND_DB_DRIVER=com.mysql.cj.jdbc.Driver
export DACHSHUND_DB_URL="jdbc:mysql://127.0.0.1:13306/dachshund_dev?characterEncoding=utf-8&characterSetResults=utf-8"
export DACHSHUND_DB_USER=dachshund_dev
export DACHSHUND_DB_PASSWORD=dachshund_dev

export DACHSHUND_SESSION_SIGNING_CURRENT_KID=v1
export DACHSHUND_SESSION_SIGNING_KEY_V1=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

export DACHSHUND_SPOTIFY_CLIENT_ID=
export DACHSHUND_SPOTIFY_CLIENT_SECRET=
export DACHSHUND_SPOTIFY_REDIRECT_URI=http://127.0.0.1:9000/spotify/auth/callback
export DACHSHUND_SPOTIFY_TOKEN_ENCRYPTION_KEY=

PATH_add .coursier/bin
